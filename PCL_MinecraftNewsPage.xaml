        </StackPanel>
      </GroupBox.Header>
      <StackPanel>
        <TextBlock Text="2026-10-25" FontSize="11" Foreground="#8B949E"/>
        <TextBlock Text="新快照加入密冰块砖方块，可用于建造与装饰，同时调整了寒冷群系的生成参数。" FontSize="12" Foreground="#C9D1DC" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
    </GroupBox>
