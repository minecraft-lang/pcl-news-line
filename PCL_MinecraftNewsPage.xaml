<StackPanel>
  <StackPanel.Resources>
    <Style TargetType="GroupBox" x:Key="NewsCard">
      <Setter Property="Background" Value="#161B22"/>
      <Setter Property="BorderBrush" Value="#30363D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="BigTitle">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
  </StackPanel.Resources>

  <local:MyCard Title="欢迎" Margin="0,0,0,16">
    <Grid Margin="0,40,0,0">
      <StackPanel>
        <TextBlock Style="{StaticResource BigTitle}" Text="Minecraft 新闻主页"/>
        <TextBlock Text="Java 版 / 基岩版 版本更新  -  快照预览  -  官方公告" FontSize="13" Foreground="#B0B7C3" Margin="0,8,0,16"/>
        <StackPanel Orientation="Horizontal">
          <local:MyButton Height="34" ColorType="Highlight" Text="刷新主页" EventType="刷新主页"/>
          <local:MyButton Height="34" Margin="12,0,0,0" Text="中文 Wiki" EventData="https://zh.minecraft.wiki/"/>
          <local:MyButton Height="34" Margin="12,0,0,0" Text="English Wiki" EventData="https://minecraft.wiki/"/>
        </StackPanel>
      </StackPanel>
    </Grid>
  </local:MyCard>

  <local:MyCard Title="近期新闻" Margin="0,0,0,16">
    <StackPanel Margin="0,40,0,0">
      <GroupBox Style="{StaticResource NewsCard}" Margin="0,0,0,12">
      <GroupBox.Header>
        <StackPanel Orientation="Horizontal">
          <Border Background="#3CAEEF" CornerRadius="9" Padding="6,1,6,1" VerticalAlignment="Center">
            <TextBlock Text="版本更新" FontSize="11" Foreground="#FFFFFF" FontWeight="Bold"/>
          </Border>
          <TextBlock Text="Java 26.3「Wilderness Bound」正式版发布" FontSize="15" Foreground="#FFFFFF" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </GroupBox.Header>
      <StackPanel>
        <TextBlock Text="2026-10-29" FontSize="11" Foreground="#8B949E"/>
        <TextBlock Text="荒野主题更新正式上线，包含新的林地生态、远行机制与多项性能优化，Java 版玩家可直接更新体验。" FontSize="12" Foreground="#C9D1DC" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
    </GroupBox>
<GroupBox Style="{StaticResource NewsCard}" Margin="0,0,0,12">
      <GroupBox.Header>
        <StackPanel Orientation="Horizontal">
          <Border Background="#3CAEEF" CornerRadius="9" Padding="6,1,6,1" VerticalAlignment="Center">
            <TextBlock Text="版本更新" FontSize="11" Foreground="#FFFFFF" FontWeight="Bold"/>
          </Border>
          <TextBlock Text="基岩版 26.52 正式版发布" FontSize="15" Foreground="#FFFFFF" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </GroupBox.Header>
      <StackPanel>
        <TextBlock Text="2026-10-28" FontSize="11" Foreground="#8B949E"/>
        <TextBlock Text="基岩版同步推送 26.52 正式版，修复跨平台联机稳定性问题，并带来移动端触控优化。" FontSize="12" Foreground="#C9D1DC" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
    </GroupBox>
