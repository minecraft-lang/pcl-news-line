      </StackPanel>
    </GroupBox>
<GroupBox Style="{StaticResource NewsCard}" Margin="0,0,0,12">
      <GroupBox.Header>
        <StackPanel Orientation="Horizontal">
          <Border Background="#B39DFF" CornerRadius="9" Padding="6,1,6,1" VerticalAlignment="Center">
            <TextBlock Text="Wiki 动态" FontSize="11" Foreground="#FFFFFF" FontWeight="Bold"/>
          </Border>
          <TextBlock Text="Minecraft Wiki 离线版更新" FontSize="15" Foreground="#FFFFFF" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </GroupBox.Header>
      <StackPanel>
        <TextBlock Text="2026-09-15" FontSize="11" Foreground="#8B949E"/>
        <TextBlock Text="中文 Minecraft Wiki 离线版更新至最新版本，支持 PCL 内嵌浏览，数据与在线版同步。" FontSize="12" Foreground="#C9D1DC" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
    </GroupBox>
    </StackPanel>
  </local:MyCard>

  <local:MyCard Title="关于本主页" Margin="0,0,0,0">
    <StackPanel Margin="0,40,0,0">
      <TextBlock Text="数据源：Minecraft Wiki，由仓库 GitHub Actions 每日自动抓取生成，刷新主页即获得最新新闻。"
                 FontSize="12" Foreground="#C9D1DC" TextWrapping="Wrap"/>
      <local:MyTextButton Margin="0,12,0,0" EventType="打开网页" Text="访问 Minecraft Wiki"
                          EventData="https://zh.minecraft.wiki/"/>
      <local:MyTextButton Margin="0,8,0,0" EventType="打开网页" Text="查看更新仓库"
                          EventData="https://github.com/minecraft-lang/pcl-news-line"/>
    </StackPanel>
  </local:MyCard>
</StackPanel>